# GitHub App credentials for token generation
# Copy this file to .env.github and fill in your values
# DO NOT commit .env.github to version control (it's gitignored)

GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=78901234

# Paste the FULL content of your .pem file below (not a file path)
# Include the BEGIN and END lines
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...
...paste your full private key here...
-----END RSA PRIVATE KEY-----"
